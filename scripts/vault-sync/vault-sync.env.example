# ── MTCD (Church) Vaultwarden Instance ──────────────────────────────────────
MTCD_URL=https://pw.server.mtcd.org
MTCD_EMAIL=tech@mtcd.org
MTCD_SYNC_FOLDER=Sync to Abraham
# Obtain Client ID & Client Secret from Web Vault:
# Settings -> Security -> Keys -> View API Key
MTCD_CLIENT_ID=
MTCD_CLIENT_SECRET=
MTCD_PASSWORD=

# ── Abraham (Personal) Vaultwarden Instance ─────────────────────────────────
ABRAHAM_URL=https://pw.abraham16.com
ABRAHAM_EMAIL=ben@abraham16.com
ABRAHAM_SYNC_FOLDER=Sync to Abraham
# Obtain Client ID & Client Secret from Web Vault:
# Settings -> Security -> Keys -> View API Key
ABRAHAM_CLIENT_ID=
ABRAHAM_CLIENT_SECRET=
ABRAHAM_PASSWORD=

# ── Sync Behavior ────────────────────────────────────────────────────────────
# Mode: bidirectional (default), mtcd_to_abraham, or abraham_to_mtcd
SYNC_MODE=bidirectional
BW_DATA_ROOT=/bw-data
