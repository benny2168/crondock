# ── MTCD (Church) Vaultwarden Instance ──────────────────────────────────────
MTCD_URL=https://pw.server.mtcd.org
MTCD_EMAIL=tech@mtcd.org
# Folder on MTCD that pushes to Abraham
MTCD_OUTBOUND_FOLDER=Sync to Abraham
# Folder on MTCD that receives from Abraham
MTCD_INBOUND_FOLDER=Sync from Abraham
# Obtain Client ID & Client Secret from Web Vault:
# Settings -> Security -> Keys -> View API Key
MTCD_CLIENT_ID=
MTCD_CLIENT_SECRET=
MTCD_PASSWORD=

# ── Abraham (Personal) Vaultwarden Instance ─────────────────────────────────
ABRAHAM_URL=https://pw.abraham16.com
ABRAHAM_EMAIL=ben@abraham16.com
# Folder on Abraham that pushes to MTCD
ABRAHAM_OUTBOUND_FOLDER=Sync to MTCD
# Folder on Abraham that receives from MTCD
ABRAHAM_INBOUND_FOLDER=Sync from MTCD
# Obtain Client ID & Client Secret from Web Vault:
# Settings -> Security -> Keys -> View API Key
ABRAHAM_CLIENT_ID=
ABRAHAM_CLIENT_SECRET=
ABRAHAM_PASSWORD=

# ── Sync Behavior ────────────────────────────────────────────────────────────
BW_DATA_ROOT=/bw-data
