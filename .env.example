# ── General ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
DATA_DIR=/data
CRONDOCK_PORT=3900

# ── Host Volume Paths (Optional overrides for docker-compose.yml) ───────────
CRONDOCK_DATA_DIR=./data
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts
HOST_BACKUPS_DIR=./backups
NPM_DATA_SRC_DIR=./nginx-proxy-data
NPM_LETSENCRYPT_SRC_DIR=./nginx-proxy-letsencrypt

# ── Authentication (OIDC / Authentik / Synology SSO) ────────────────────────
AUTH_PROVIDER=oidc
LOGIN_PROVIDER_NAME=Authentik SSO
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/crondock/.well-known/openid-configuration
OIDC_REDIRECT_URI=https://cron.example.com/auth/callback

# ── Session Security ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-byte-random-hex-secret
SESSION_COOKIE_NAME=crondock_session
SESSION_MAX_AGE_HOURS=24

# ── Optional IAM & Portainer Seed Defaults ──────────────────────────────────
IAM_API_KEY=
ABRAHAM_PORTAINER_URL=https://docker.example.com
ABRAHAM_PORTAINER_TOKEN=
MTCD_PORTAINER_URL=https://docker.example.org
MTCD_PORTAINER_TOKEN=

