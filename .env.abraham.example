# Copy to .env.abraham and fill in real values.
# .env.abraham is gitignored — never commit it.
# On the Mac mini this file lives at:
#   /Users/benny2168/Antigravity/crondock/.env.abraham
# Deploy with:
#   docker compose --env-file .env.abraham -f docker-compose.abraham.yml up -d

# ── Authentik OIDC ─────────────────────────────────────────────────────────
OIDC_CLIENT_ID=your-client-id-here
OIDC_CLIENT_SECRET=your-client-secret-here

# ── Session cookie signing ─────────────────────────────────────────────────
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ── Portainer (Abraham Synology) ───────────────────────────────────────────
PORTAINER_URL=https://docker.abraham16.com
PORTAINER_TOKEN=ptr_your-token-here
PORTAINER_ENDPOINT_ID=5

# ── Warm-standby target (Abraham Synology via Tailscale) ───────────────────
STANDBY_HOST=100.91.132.90
STANDBY_SSH_USER=ben
